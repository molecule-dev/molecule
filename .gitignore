# dependencies
node_modules

# build output
dist
*.tsbuildinfo
*.js.map
*.d.ts
# A `.d.ts` under a package's src/ is always hand-written (every build emits to
# dist/): ambient typings for runtime-loaded native peers (react-native, expo-*,
# `bcrypt`), JSX augmentations (solid-ui's `attr:` attributes) and the like. It
# must be tracked — `*.d.ts` above would otherwise drop it from the commit and
# break a fresh clone's build, while the author's own tree still compiles.
!packages/**/src/**/*.d.ts
*.d.ts.map

# compiled JS from TypeScript (keep hand-written .js like eslint.config.js)
packages/**/src/**/*.js
packages/**/vitest.config.js
# svelte-package stages its output here
.svelte-kit
vitest.workspace.js

# testing
coverage

# misc
.DS_Store
.env*
.vscode

# logs
*.log
npm-debug.log*

# keys
.keys

# Transient failure ledgers written by the publish/trust scripts.
.publish-failures.json
.trust-failures.json
.trust-state.json

# CI dist-cache index (written by scripts/dist-cache-manifest.mjs, restored from
# the Actions cache). Build-output metadata, never source.
.dist-manifest.json
