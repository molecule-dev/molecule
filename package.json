{
  "name": "molecule",
  "type": "module",
  "private": true,
  "description": "Composable, injectable modules for full-stack applications",
  "workspaces": [
    "packages/api/ai/*",
    "packages/api/bonds/*/*",
    "packages/api/ci/*",
    "packages/api/core/*",
    "packages/api/infrastructure/*",
    "packages/api/locales/*",
    "packages/api/middleware/*",
    "packages/api/resources/*",
    "packages/api/staging/*",
    "packages/api/testing",
    "packages/api/testing/*",
    "packages/api/utilities/*",
    "packages/app/bonds/*/*",
    "packages/app/bonds/native/*/*",
    "packages/app/core/*",
    "packages/app/features/*",
    "packages/app/frameworks/*",
    "packages/app/infrastructure/*",
    "packages/app/locales/*",
    "packages/app/native/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "changeset": "changeset",
    "check:changesets-consumed": "node scripts/check-changesets-consumed.mjs",
    "check:feature-jsdocs": "node scripts/check-feature-jsdocs.mjs --check",
    "check:i18n-parity": "node scripts/check-i18n-parity.js --check",
    "check:locale-placeholders": "node scripts/check-locale-placeholders.js",
    "check:lockfile": "node scripts/check-lockfile.js",
    "check:package-metadata": "node scripts/check-package-metadata.mjs",
    "check:package-repository": "node scripts/check-package-repository.js",
    "check:peer-deps": "node scripts/check-peer-deps.js",
    "check:publishable": "node scripts/check-publishable.mjs",
    "check:security-workflow": "node scripts/check-security-workflow.js",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:undeclared-imports": "node scripts/check-undeclared-imports.mjs",
    "check:ws-floor": "node scripts/check-ws-floor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages/ --max-warnings 0",
    "lint:fix": "eslint packages/ --fix --max-warnings 0",
    "prepare": "husky",
    "release": "npm run build && node scripts/publish-paced.mjs",
    "release:changesets": "changeset publish",
    "sync:lockfile": "node scripts/sync-lockfile.js",
    "test": "node scripts/vitest-with-tmp-root.mjs run",
    "test:all": "npm run test --workspaces --if-present",
    "trust:new": "node scripts/trust-new-packages.mjs",
    "version": "changeset version && npm install --package-lock-only --no-audit --no-fund"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@bufbuild/protobuf": "2.16.0",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@tanstack/table-core": "8.21.3",
    "@tanstack/virtual-core": "3.19.7",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "handlebars": "4.7.10",
    "husky": "9.1.7",
    "jimp": "1.6.1",
    "jsdom": "30.1.3",
    "mjml": "5.4.1",
    "monaco-editor": "0.56.0",
    "node-cron": "4.6.0",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.19.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "overrides": {
    "ws": "8.22.0",
    "adm-zip": "0.6.0",
    "sharp": "0.35.5",
    "dompurify": "3.4.17",
    "ip-address": "10.7.4",
    "vite": "8.3.5",
    "follow-redirects": "1.16.1",
    "csv-parse": "7.0.3",
    "image-size": "2.0.4",
    "js-yaml": "4.3.2",
    "svgo": "4.1.0",
    "devalue": "5.9.2",
    "proxy-addr": "2.0.8",
    "fast-copy": "4.1.2",
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2",
    "@types/retry": "0.12.5"
  },
  "license": "Apache-2.0"
}
