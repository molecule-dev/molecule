#!/usr/bin/env bash
# Staged-only pre-commit hook. Original ran format:check + lint + tests over the
# entire monorepo (~30s), which serialised badly when many parallel agents were
# committing concurrently — the wide hook window let other agents' staged files
# bleed across commits. This version scopes format/lint to staged files and
# defers `npm test` to CI; lockfile + peer-deps checks remain.

set -e

# WHICH BASE THIS HOOK DIFFS.
#
# `scripts/lib/commit-staged-paths.mjs` runs this hook against a PRIVATE index that
# is pinned to one speculative attempt's parent, and it passes that parent here.
# The live HEAD may move while the hook runs (a peer session commits); diffing the
# pinned index against the NEW HEAD then reads the peer's commit as staged
# reversions of the peer's own paths. On 2026-10-19 that widened the README regen
# to a peer's auth paths, and a failed attempt copied the generated docs over
# newer peer content in the shared worktree. Diff the attempt's parent instead.
# Unset for an ordinary commit, where the parent IS HEAD.
DIFF_BASE=${MOL_PRECOMMIT_BASE:-}
staged_diff() {
  if [ -n "$DIFF_BASE" ]; then git diff --cached "$DIFF_BASE" "$@"; else git diff --cached "$@"; fi
}

# Fast secret scan — blocks a commit that introduces a high-confidence secret
# (staged added lines only). Runs first so a leaked key fails before the slower
# format/lint pass. Bypass a reviewed false positive with: git commit --no-verify
node scripts/precommit-secret-scan.mjs

# Secret-scanner drift (cross-repo). scripts/precommit-secret-scan.mjs here is a
# VENDORED copy of the workspace canonical (../scripts/precommit-secret-scan.mjs).
# This repo's copy was the NEWEST when they diverged — the false-positive
# exemptions were added here and nowhere else, so the other three kept blocking
# `postgres://postgres:postgres@localhost` in docs. Fix the canonical, then sync.
# Only checked when this copy is staged; skipped in a standalone clone.
if staged_diff --name-only --diff-filter=ACM |
  grep -q '^scripts/precommit-secret-scan\.mjs$'; then
  if [ -f ../scripts/sync-secret-scanner.mjs ]; then
    (cd .. && node scripts/sync-secret-scanner.mjs --check)
  fi
fi

# Shared-lint-rule drift (cross-repo), same shape as the scanner check above.
# eslint-rules/*.mjs here are VENDORED copies of the workspace canonical
# (../scripts/eslint-rules/). molecule-dev/app carries the same files, and a
# rule that fires in one repo but not the other is worse than no rule — the
# design inconsistency simply migrates to the repo whose copy fell behind.
# Only checked when a copy is staged; skipped in a standalone clone.
if staged_diff --name-only --diff-filter=ACM |
  grep -q '^eslint-rules/.*\.mjs$'; then
  if [ -f ../scripts/sync-eslint-rules.mjs ]; then
    (cd .. && node scripts/sync-eslint-rules.mjs --check)
  fi
fi

# PATHSPEC COMMIT DETECTION — load-bearing for the README regen at the bottom.
#
# `git commit -- <paths>` (and `--only`) builds a TEMPORARY index from HEAD plus
# the named paths, points GIT_INDEX_FILE at it, and runs this hook against that.
# Measured on git 2.43: the hook's index write DOES reach the commit (it writes
# the temp index, which is what gets committed) — but the REAL index is never
# updated, and is LOCKED for the duration, so the hook cannot update it either.
# The regenerated README.md files therefore land in the commit correctly and
# then read as `MM` in `git status` forever after: a phantom diff between a
# stale index entry and a HEAD that already agrees with the worktree. The next
# agent meets that as foreign dirt they must not touch (workspace Rule 25), and
# it survives every later commit until someone re-stages.
#
# So: do not block — the commit is correct — but say exactly what to run. Git
# names the temp index `$GIT_DIR/next-index-<pid>`, which is the tell. (Keep
# this block byte-stable: scripts/__tests__/precommit-pathspec.test.mjs extracts
# and executes it.)
PATHSPEC_COMMIT=0
case "${GIT_INDEX_FILE:-}" in
*next-index*) PATHSPEC_COMMIT=1 ;;
esac

STAGED=$(staged_diff --name-only --diff-filter=AM)

# mlcl is a workspace member of the parent checkout, so its bins hoist to the
# workspace root; a standalone mlcl install keeps them local. Resolve once, as a
# path valid from INSIDE mlcl (the cross-repo checks below cd there first).
MLCL_TSX=""
if [ -x ../mlcl/node_modules/.bin/tsx ]; then MLCL_TSX=node_modules/.bin/tsx
elif [ -x ../node_modules/.bin/tsx ]; then MLCL_TSX=../node_modules/.bin/tsx
fi
if [ -z "$STAGED" ]; then
  exit 0
fi

JSTS=$(echo "$STAGED" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)
JSON_MD=$(echo "$STAGED" | grep -E '\.(json|md|css|scss|html|yaml|yml)$' || true)

if [ -n "$JSTS" ]; then
  echo "$JSTS" | xargs npx --no-install prettier --check
  # --max-warnings 0 is LOAD-BEARING, not decoration. Bare `eslint <files>` exits
  # 0 when there are only warnings, and this config reports almost everything as
  # a warning — so from 2026-05-01 (when this hook was scoped to staged files and
  # the flag was dropped) until 2026-08-03 the lint step could not fail on a
  # warning, and 732 of them accumulated behind a green hook. `npm run lint` has
  # always carried the flag; the hook must match it or it is not the same gate.
  echo "$JSTS" | xargs npx --no-install eslint --no-error-on-unmatched-pattern --max-warnings 0
fi

# Every staged TypeScript file must PARSE (milliseconds; the parser only, no
# types). A `*/` inside a JSDoc example once ended the doc comment early and the
# package built as garbage; eslint and the doc-example verifier both read past
# it, and the first parser it met was the owner's trust:new run before a publish.
TS_STAGED=$(echo "$STAGED" | grep -E '\.(ts|tsx|mts|cts)$' || true)
if [ -n "$TS_STAGED" ]; then
  echo "$TS_STAGED" | xargs node scripts/check-syntax.mjs
fi

# .md is checked here (it was `.prettierignore`d until 2026-08-03, which is how
# ~900 generated README.md files drifted). *.json is still ignored on purpose —
# registry.json and the locale data are machine-written.
if [ -n "$JSON_MD" ]; then
  echo "$JSON_MD" | xargs npx --no-install prettier --check
fi

npm run check:lockfile

# Internal @molecule version coherence: every package a workspace member, every
# internal dep range matching the version actually in the repo, and the lockfiles
# agreeing. check:lockfile above proves the lock RESOLVES; it does not notice a
# package at 1.0.1 that still depends on 1.0.0. Skipped in a standalone clone
# where the workspace root is absent.
if [ -f ../scripts/verify-molecule-versions.mjs ]; then
  ( cd .. && node scripts/verify-molecule-versions.mjs --quiet ) || exit 1
fi
npm run check:peer-deps

# Every publishable package must declare the CORRECT repository. With provenance
# on, npm signs a Sigstore bundle naming the source repo and the registry rejects
# the publish with E422 unless package.json agrees. 548 packages declared none at
# all, and ten declared a wrong one — including a stranger's GitHub repo — which
# nothing noticed for four months because nothing read the field.
npm run check:package-repository
# …and the rest of what a publish needs: Apache-2.0 license field, a LICENSE
# copy in the package dir, the molecule.dev homepage, README.md in files. A
# generated package shipped without any of them and the registry was the first
# thing to notice (2026-09-28).
npm run check:package-metadata
# i18n parity (cross-cutting-i18n) — full-tree scan, but fast (~0.1s) and it
# only fails on NEW missing keys vs the baseline, so a string shipped as an
# inline defaultValue without its bond key is caught here at commit time, not
# weeks later. (Whole-tree, not staged-only: a key added in package A must be
# checked against its owning locale bond in package B.)
npm run check:i18n-parity

# Interpolation placeholders — a {{name}} in a translation is a VARIABLE, not
# prose. An upstream machine-translation step translated the names themselves
# ({{title}} -> {{titel}}) and leaked its own <x> markup, so 5,816 values across
# 40 bonds rendered the raw token instead of the value — mostly in aria-labels,
# i.e. squarely on screen-reader users. Key-presence tests cannot see it: the
# value is a non-empty string either way. Whole-tree and ~0.3s.
npm run check:locale-placeholders

# Registry export-drift gate (same spirit as i18n-parity, but cross-REPO). A
# package's public exports are the source of truth, yet they are recorded in
# mlcl/registry.json — a SEPARATE repo whose CI never checks this one out, so a
# changed export drifts the registry silently until a manual sync (that is how
# 815 packages' exports went stale once). Catch it here, at the commit that
# changes the exports, scoped to only the staged packages so it stays fast under
# parallel agents. Runs the check via tsx against mlcl SOURCE (no build needed —
# the scanner subgraph imports no @molecule/* packages). Skips (does not block)
# when mlcl is a non-sibling or its deps aren't installed — e.g. a standalone
# molecule clone — where the registry simply isn't reachable.
# The gates below that read package SOURCE read the source this commit carries:
# one export of the index (`git checkout-index`, which honours a private
# GIT_INDEX_FILE and a pathspec commit's temporary index), made once, on first
# use. The worktree is the wrong input in a shared checkout: another session's
# uncommitted export in the same package made this registry check refuse a
# commit that did not touch it (2026-10-17, ai-tools), and made the README regen
# below document code no commit had. It lives under the workspace root so
# packages resolve the same node_modules the checkout does (prepareDocsCheckTree
# in ../scripts/lib/release-ci-gates.mjs).
INDEX_TREE=""
index_tree() {
  if [ -z "$INDEX_TREE" ]; then
    INDEX_TREE="$(cd .. && pwd)/.precommit-docs-$$"
    rm -rf "$INDEX_TREE"
    # set -e exits on a failed gate; the 190 MB export must not outlive the hook.
    trap 'rm -rf "$INDEX_TREE"' EXIT
    git checkout-index -a --prefix="$INDEX_TREE/"
    node -e "import('../scripts/lib/release-ci-gates.mjs').then((m) => m.prepareDocsCheckTree({ moleculeDir: process.cwd(), treeDir: process.argv[1] }))" "$INDEX_TREE"
  fi
}

PKG_SRC=$(echo "$STAGED" | grep -E '^packages/.+/src/' || true)
if [ -n "$PKG_SRC" ]; then
  PKG_DIRS=$(echo "$PKG_SRC" | while IFS= read -r f; do echo "${f%%/src/*}"; done | sort -u)
  if [ -n "$MLCL_TSX" ]; then
    index_tree
    ( cd ../mlcl && MOLECULE_PACKAGES_DIR="$INDEX_TREE/packages" "$MLCL_TSX" scripts/check-registry-exports.mjs $PKG_DIRS )
  else
    echo "ℹ registry-export check skipped: mlcl deps not installed — run 'npm ci' in mlcl, then 'npm run verify:registry-exports' to verify"
  fi
fi

# Doc-example gate (cross-repo, same skip semantics as the registry check above).
# README.md examples are copied nearly verbatim by molecule.dev's executor; a
# non-compiling example (removed upstream API, missing await, phantom package)
# is a guaranteed executor debugging tangent. Scoped to staged packages whose
# src/index.ts changed, so it stays fast under parallel agents. The fleet was
# brought to zero failures when this gate landed — keep it there.
IDX_CHANGED=$(echo "$STAGED" | grep -E '^packages/.+/src/index\.ts$' || true)
if [ -n "$IDX_CHANGED" ] && [ -f ../scripts/verify-doc-examples.mjs ]; then
  IDX_DIRS=$(echo "$IDX_CHANGED" | while IFS= read -r f; do echo "${f%%/src/*}"; done | sort -u)
  ( cd .. && node scripts/verify-doc-examples.mjs $IDX_DIRS )
fi

# README.md auto-regen (cross-repo, same skip semantics as the checks above).
# README.md is 100% generated — never hand-edited — so a commit that changes a
# package's src/ or package.json must carry the regenerated doc, or the docs the
# executor reads via read_molecule_doc drift from the source being committed.
# Regenerates ONLY the staged packages (plus cross-doc dependents: a core's
# providers inherit its @e2e, a provider's core lists its providers, a new
# locale's feature gains a companion-locale section, a re-exporting package
# embeds the re-exported API) — ~0.4s/package via tsx
# against mlcl source, no build needed — then auto-stages the refreshed
# README.md files into THIS commit (script prints changed paths on stdout).
# Generation reads the source BEING COMMITTED — an export of the index
# (`git checkout-index`, which honours a private GIT_INDEX_FILE and the
# temporary index of a pathspec commit) — never the worktree. Reading the
# worktree documented other sessions' uncommitted source: on 2026-10-17 a commit
# to app-http regenerated the framework READMEs, which embed app-auth's API,
# from an app-auth worktree carrying another session's unstaged
# `browser-storage.ts`, and the release's docs gate then failed on READMEs
# describing code no commit had. The export lives under the workspace root so
# packages resolve the same `node_modules` the checkout does (see
# prepareDocsCheckTree in ../scripts/lib/release-ci-gates.mjs). Uses its own
# diff-filter (incl. D): a deleted src file changes the public API and thus the
# doc, which --diff-filter=AM would miss.
#
# A staged package.json selects its package only when the edit can reach a
# generation input (name / peerDependencies / an @types mirror — see
# mlcl/src/lib/doc-inputs.ts). A test-tool pin cannot, and selecting on ANY
# manifest change made a fleet-wide vitest bump regenerate/check all ~1030
# packages — over ten minutes per attempt (2026-10-22). The decision reads the
# BASE blob and the INDEX blob (doc-manifest-scope.mjs --staged); a helper
# failure keeps every manifest in scope, never narrows it.
DOC_SRC=$(staged_diff --name-only --diff-filter=ACMRD -- 'packages/**/src/**' 'packages/**/README.md' || true)
DOC_MANIFEST_STATUS=$(staged_diff --name-status --no-renames --diff-filter=ACMRD -- 'packages/**/package.json' || true)
DOC_MANIFEST_DIRS=""
DOC_MANIFEST_PATHS=""
if [ -n "$DOC_MANIFEST_STATUS" ]; then
  DOC_MANIFEST_SPLIT=$(echo "$DOC_MANIFEST_STATUS" | while IFS="$(printf '\t')" read -r status file; do
    [ -n "$file" ] || continue
    if [ "$status" = "M" ]; then
      echo "path $file"
    else
      # Added/deleted/renamed/type-changed: no comparable pair, keep the package.
      echo "dir ${file%/package.json}"
    fi
  done)
  DOC_MANIFEST_DIRS=$(echo "$DOC_MANIFEST_SPLIT" | grep '^dir ' | cut -d' ' -f2- || true)
  DOC_MANIFEST_PATHS=$(echo "$DOC_MANIFEST_SPLIT" | grep '^path ' | cut -d' ' -f2- || true)
fi
if [ -n "$DOC_MANIFEST_PATHS" ] && [ -n "$MLCL_TSX" ]; then
  MOLECULE_REPO=$(pwd)
  # Word-split on purpose (package paths carry no whitespace). On failure the
  # helper prints nothing, so keep EVERY manifest rather than silently narrowing.
  # shellcheck disable=SC2086
  if DOC_MANIFEST_KEEP=$( cd ../mlcl && "$MLCL_TSX" scripts/doc-manifest-scope.mjs \
      --staged --base="${DIFF_BASE:-HEAD}" --repo="$MOLECULE_REPO" $DOC_MANIFEST_PATHS ); then
    # `|| true`: an empty keep-list would otherwise leave the substitution's
    # while-loop status at 1 and `set -e` would fail the commit.
    DOC_MANIFEST_DIRS="${DOC_MANIFEST_DIRS}
$(echo "$DOC_MANIFEST_KEEP" | while IFS= read -r f; do [ -n "$f" ] && echo "${f%/package.json}"; done || true)"
  else
    DOC_MANIFEST_DIRS="${DOC_MANIFEST_DIRS}
$(echo "$DOC_MANIFEST_PATHS" | while IFS= read -r f; do echo "${f%/package.json}"; done)"
  fi
fi
DOC_SRC_DIRS=$(echo "$DOC_SRC" | while IFS= read -r f; do [ -n "$f" ] || continue; d="${f%%/src/*}"; echo "${d%/README.md}"; done || true)
DOC_DIRS=$(printf '%s\n%s\n' "$DOC_SRC_DIRS" "$DOC_MANIFEST_DIRS" | grep -v '^$' | sort -u || true)
if [ -n "$DOC_DIRS" ]; then
  if [ -n "$MLCL_TSX" ]; then
    index_tree
    REGENERATED=$( cd ../mlcl && MOLECULE_PACKAGES_DIR="$INDEX_TREE/packages" "$MLCL_TSX" scripts/regen-molecule-docs.mjs $DOC_DIRS )
    if [ -n "$REGENERATED" ]; then
      # Each generated doc enters THIS index as a blob object — `git hash-object`
      # + `update-index` honour a private index and a pathspec commit's temporary
      # index — and the shared worktree is NOT written here. A private-index
      # attempt may still fail a gate or lose its compare-and-swap, and publishing
      # mid-hook is how a failed attempt overwrote newer peer README content on
      # 2026-10-19. commit-staged-paths.mjs publishes after its CAS lands, each
      # file gated on the destination still holding the attempt's parent.
      DEFERRED_DOCS=""
      # Word-split on purpose: the generator prints one package README path per
      # line and such paths carry no whitespace. A here-string would need bash,
      # and husky runs this hook with `sh -e`, not its bash shebang.
      # shellcheck disable=SC2086
      for md in $REGENERATED; do
        [ -n "$md" ] || continue
        sha=$(git hash-object -w -- "$INDEX_TREE/$md")
        # An explicitly staged README is another writer's input. Never replace it
        # silently; a stale generated document must refuse this commit instead.
        if printf '%s\n' "$DOC_SRC" | grep -Fxq -- "$md" &&
            [ "$(git rev-parse --verify ":$md" 2>/dev/null || true)" != "$sha" ]; then
          echo "Generated README has staged changes that differ from its source: $md" >&2
          echo "Regenerate this README before committing it." >&2
          exit 1
        fi
        # These are staged AFTER the prettier/eslint pass above, so they would
        # otherwise enter the commit unchecked — which is how generated docs
        # stayed off-standard for months. The generator now Prettier-formats its
        # own output; this asserts that rather than trusting it, reading the
        # SNAPSHOT being committed — never a peer's worktree copy of the file.
        git cat-file blob "$sha" | npx --no-install prettier --check --stdin-filepath "$md"
        if [ -n "${MOL_PRECOMMIT_MANIFEST:-}" ]; then
          # Speculative private-index attempt: stage it and record it; the caller
          # publishes it to the shared worktree/index after the commit lands.
          git update-index --add --cacheinfo "100644,$sha,$md"
          printf '%s\t%s\n' "$sha" "$md" >> "$MOL_PRECOMMIT_MANIFEST"
        else
          # Direct commit: stage and publish at the END, once every gate passed.
          DEFERRED_DOCS="${DEFERRED_DOCS}${sha} ${md}
"
        fi
      done
      echo "✎ README.md regenerated + staged into this commit:"
      echo "$REGENERATED" | while IFS= read -r md; do echo "    $md"; done
    fi
  else
    echo "ℹ README.md regen skipped: mlcl deps not installed — run 'npm ci' in mlcl, then 'cd mlcl && npm run sync-docs:changed'"
  fi
fi

# Live model-dispatch gate (cross-repo, LAST because it hits the network). A
# model added or updated in the AI catalog must prove it serves a request
# shaped EXACTLY the way Synthase sends one (function tools + the catalog's
# webSearchToolType server tool + the resolved thinking/effort block, through
# the real bond and region dispatch) before it can be committed. This exists
# because glm-5.3-flash shipped 2026-08-28 with a webSearchToolType both zhipu
# hosts reject — every Synthase turn on it failed, while a hand-rolled probe of
# the model worked, and glm-5.2 had carried the same broken flag unnoticed
# since 2026-07-07. Scoped to the model entries the staged diff actually
# adds/changes (a few probes, ~5-15s), so cron autofix commits are gated too.
# Skips (does not block) when molecule-dev isn't a sibling; providers without
# keys are skipped inside the gate, never failed.
if staged_diff --name-only --diff-filter=ACM |
  grep -q '^packages/api/resources/ai-models/src/models\.ts$'; then
  if [ -f ../molecule-dev/scripts/verify-model-dispatch.mjs ]; then
    ( cd .. && node molecule-dev/scripts/verify-model-dispatch.mjs --staged-catalog molecule )
  else
    echo "ℹ model-dispatch gate skipped: molecule-dev not a sibling — run 'npm run verify:model-dispatch <changed-ids>' in molecule-dev before shipping catalog changes"
  fi
fi

# Publish a DIRECT commit's generated docs — only now, after every gate has
# passed, so a failed hook leaves the worktree and index exactly as it found
# them. Each destination is written only while it still holds the blob of this
# commit's parent: a peer's staged or unstaged edit to the same README (made
# before or during the hook) wins and is never replaced by the generated doc.
# A speculative private-index attempt publishes through commit-staged-paths.mjs
# instead, after its compare-and-swap lands (see PATHSPEC/DIFF_BASE above).
if [ -n "${DEFERRED_DOCS:-}" ]; then
  PUBLISH_BASE=${DIFF_BASE:-HEAD}
  # A pipe (not a here-string): husky runs this hook with `sh -e`. The loop's
  # writes are git commands (side effects), so running it in a subshell is fine.
  printf '%s\n' "$DEFERRED_DOCS" | while read -r sha md; do
    [ -n "$md" ] || continue
    want=$(git rev-parse -q --verify "$PUBLISH_BASE:$md" 2>/dev/null || true)
    if [ -f "$md" ]; then cur=$(git hash-object -- "$md"); else cur=""; fi
    entry_sha=""
    if entry=$(git ls-files -s -- "$md"); then
      # shellcheck disable=SC2086 # split "<mode> <sha> <stage>\t<path>" on purpose
      set -- $entry
      if [ "$#" = 4 ] && [ "$3" = "0" ]; then entry_sha=$2; fi
    fi
    index_safe=0
    worktree_safe=0
    if [ -n "$want" ]; then
      if [ "$entry_sha" = "$want" ]; then index_safe=1; fi
      if [ "$cur" = "$want" ]; then worktree_safe=1; fi
    else
      if [ -z "$entry_sha" ]; then index_safe=1; fi
      if [ -z "$cur" ]; then worktree_safe=1; fi
    fi
    if [ "$index_safe" = 1 ]; then
      git update-index --add --cacheinfo "100644,$sha,$md"
    fi
    if [ "$worktree_safe" = 1 ]; then
      git cat-file blob "$sha" > "$md"
    fi
  done
  if [ "$PATHSPEC_COMMIT" = 1 ]; then
    # They ARE in the commit (see the block at the top). What is stale is the
    # real index, which this hook cannot reach — so name the one command that
    # clears the phantom diff, rather than leaving it for whoever runs
    # `git status` next and cannot tell whose changes these are.
    echo "⚠ This commit used an explicit pathspec, so your real index still holds the"
    echo "  OLD blobs for those docs and they will read as modified until you re-stage."
    echo "  After this commit, run:"
    echo "      git add $(echo "$DEFERRED_DOCS" | while read -r sha md; do echo "$md"; done | tr '\n' ' ')"
  fi
fi
