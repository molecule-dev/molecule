{
  "name": "@molecule/app-ui-vue",
  "version": "1.3.1",
  "description": "Vue UI components for molecule.dev",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/Tooltip.js": {
      "types": "./dist/components/Tooltip.d.ts",
      "default": "./dist/components/Tooltip.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "vue-tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/frameworks/vue-ui"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-icons": "^1.0.1",
    "@molecule/app-ui": "^1.5.0",
    "@molecule/app-vue": "^3.13.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-i18n": "1.2.2",
    "@molecule/app-icons": "1.0.4",
    "@molecule/app-vue": "3.13.0",
    "@testing-library/dom": "10.4.2",
    "@types/node": "26.6.5",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  },
  "homepage": "https://www.molecule.dev/packages/app-ui-vue",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
