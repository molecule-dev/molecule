{
  "name": "@molecule/app-ui-react",
  "version": "4.12.1",
  "description": "React UI primitive bundle for molecule.dev — Button, Modal, Tooltip, Toast, Alert, Card, Badge, Avatar, Tabs, Accordion, Dropdown, Select, Checkbox, Switch, Input, Table, Spinner, Skeleton, Progress and more. Import these primitives; do not rebuild them.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.web.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.web.d.ts",
        "default": "./dist/index.web.js"
      },
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "types": "./dist/index.web.d.ts",
      "import": "./dist/index.web.js"
    },
    "./components/Tooltip.js": {
      "browser": {
        "types": "./dist/components/Tooltip.web.d.ts",
        "default": "./dist/components/Tooltip.web.js"
      },
      "react-native": {
        "types": "./dist/components/Tooltip.native.d.ts",
        "default": "./dist/components/Tooltip.native.js"
      },
      "types": "./dist/components/Tooltip.web.d.ts",
      "import": "./dist/components/Tooltip.web.js"
    },
    "./elements": {
      "browser": {
        "types": "./dist/elements/index.d.ts",
        "default": "./dist/elements/index.js"
      },
      "react-native": {
        "types": "./dist/elements/native.d.ts",
        "default": "./dist/elements/native.js"
      },
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js"
    },
    "./platform": {
      "browser": {
        "types": "./dist/platform/index.d.ts",
        "default": "./dist/platform/index.js"
      },
      "react-native": {
        "types": "./dist/platform/native.d.ts",
        "default": "./dist/platform/native.js"
      },
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "pretest": "npm run typecheck:tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "node scripts/typecheck-tests.mjs"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@molecule/app-inline-style-dom": "1.2.0",
    "@molecule/app-overlay-dom": "1.1.0",
    "@molecule/app-pointer-events-dom": "1.1.0"
  },
  "peerDependencies": {
    "@molecule/app-filesystem": "^1.1.0",
    "@molecule/app-i18n": "^1.3.0",
    "@molecule/app-icons": "^1.0.1",
    "@molecule/app-react": "^4.15.0",
    "@molecule/app-ui": "^1.14.0",
    "@molecule/app-ui-react-native": "^2.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@molecule/app-filesystem": "1.1.0",
    "@molecule/app-i18n": "1.3.0",
    "@molecule/app-icons": "1.0.4",
    "@molecule/app-react": "4.17.0",
    "@molecule/app-routing": "1.5.3",
    "@molecule/app-ui-react-native": "2.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/frameworks/react-ui"
  },
  "homepage": "https://www.molecule.dev/packages/app-ui-react",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@molecule/app-ui-react-native": {
      "optional": true
    }
  }
}
