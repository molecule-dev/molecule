{
  "name": "@molecule/app-ui-solid",
  "version": "1.9.0",
  "description": "Solid UI components for molecule.dev",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/Tooltip.js": {
      "types": "./dist/components/Tooltip.d.ts",
      "default": "./dist/components/Tooltip.jsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/frameworks/solid-ui"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@molecule/app-inline-style-dom": "1.2.0",
    "@molecule/app-overlay-dom": "1.1.0",
    "@molecule/app-pointer-events-dom": "1.1.0"
  },
  "peerDependencies": {
    "@molecule/app-filesystem": "^1.1.0",
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-icons": "^1.0.1",
    "@molecule/app-solid": "^3.15.0",
    "@molecule/app-ui": "^1.12.0",
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@molecule/app-filesystem": "1.1.0",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-i18n": "1.3.0",
    "@molecule/app-icons": "1.0.4",
    "@molecule/app-solid": "3.17.0",
    "@testing-library/dom": "10.4.2",
    "@types/node": "26.6.5",
    "jsdom": "31.0.1",
    "solid-js": "1.9.17",
    "typescript": "6.0.3",
    "vite-plugin-solid": "2.11.15",
    "vitest": "4.1.12"
  },
  "homepage": "https://www.molecule.dev/packages/app-ui-solid",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
