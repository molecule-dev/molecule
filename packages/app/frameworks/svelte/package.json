{
  "name": "@molecule/app-svelte",
  "version": "3.4.0",
  "description": "Svelte framework bindings for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && svelte-package --input src --output dist --tsconfig ./tsconfig.json",
    "dev": "svelte-package --input src --output dist --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@molecule/app-ai-chat": "^1.8.0",
    "@molecule/app-ai-models": "^1.0.1",
    "@molecule/app-auth": "^3.0.0",
    "@molecule/app-code-editor": "^1.0.1",
    "@molecule/app-device": "^1.0.1",
    "@molecule/app-forms": "^2.3.1",
    "@molecule/app-http": "^1.0.1",
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-ide": "^1.0.1",
    "@molecule/app-live-preview": "^1.0.1",
    "@molecule/app-logger": "^1.0.1",
    "@molecule/app-platform": "^1.0.1",
    "@molecule/app-push": "^1.0.1",
    "@molecule/app-routing": "^1.1.0",
    "@molecule/app-state": "^1.2.0",
    "@molecule/app-storage": "^1.1.1",
    "@molecule/app-theme": "^1.0.1",
    "@molecule/app-ui": "^1.0.1",
    "@molecule/app-utilities": "^1.0.1",
    "@molecule/app-version": "^1.0.1",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@molecule/app-code-editor": {
      "optional": true
    },
    "@molecule/app-ide": {
      "optional": true
    },
    "@molecule/app-live-preview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@molecule/app-ai-chat": "1.8.0",
    "@molecule/app-ai-models": "1.4.4",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-utilities": "1.0.6",
    "@sveltejs/package": "3.0.2",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "26.6.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/frameworks/svelte"
  },
  "homepage": "https://www.molecule.dev/packages/app-svelte",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
