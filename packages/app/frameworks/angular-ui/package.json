{
  "name": "@molecule/app-ui-angular",
  "version": "1.3.1",
  "description": "Angular UI components for molecule.dev",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/Tooltip.js": {
      "types": "./dist/components/tooltip.component.d.ts",
      "default": "./dist/components/tooltip.component.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "ngc",
    "dev": "ngc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/frameworks/angular-ui"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@molecule/app-angular": "^3.10.0",
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-icons": "^1.0.1",
    "@molecule/app-ui": "^1.5.0"
  },
  "devDependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@molecule/app-angular": "3.10.0",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-i18n": "1.2.2",
    "@molecule/app-icons": "1.0.4",
    "@testing-library/dom": "10.4.2",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "zone.js": "0.16.3"
  },
  "homepage": "https://www.molecule.dev/packages/app-ui-angular",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
