     "\n@route /settings?tab=2"
    ],
    "calls": []
   },
   "several route changes": {
    "snapshots": [
     "\n@route /one",
     "\n@route /two?x=1",
     "\n@route /three",
     "\n@route /one"
    ],
    "calls": []
   },
   "unmounted after a route change": {
    "snapshots": [
     "\n@route /before",
