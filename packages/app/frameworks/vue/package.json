{
  "name": "@molecule/app-vue",
  "version": "3.14.0",
  "description": "Vue framework bindings for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "default": "./dist/link.js"
    },
    "./testing/setup": {
      "types": "./dist/testing/setup.d.ts",
      "default": "./dist/testing/setup.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@molecule/app-ai-chat": "^1.8.0",
    "@molecule/app-ai-models": "^1.0.1",
    "@molecule/app-auth": "^3.0.0",
    "@molecule/app-code-editor": "^1.0.1",
    "@molecule/app-device": "^1.0.1",
    "@molecule/app-forms": "^2.4.0",
    "@molecule/app-http": "^1.0.1",
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-ide": "^1.0.1",
    "@molecule/app-live-preview": "^1.0.1",
    "@molecule/app-logger": "^1.0.1",
    "@molecule/app-platform": "^1.0.1",
    "@molecule/app-push": "^1.0.1",
    "@molecule/app-routing": "^1.4.0",
    "@molecule/app-routing-vue-router": ">=1.4.0",
    "@molecule/app-state": "^1.2.0",
    "@molecule/app-storage": "^1.1.1",
    "@molecule/app-theme": "^1.0.1",
    "@molecule/app-ui": "^1.0.1",
    "@molecule/app-utilities": "^1.0.1",
    "@molecule/app-version": "^1.0.1",
    "vitest": "^4.1.0",
    "vue": "^3.4.20"
  },
  "peerDependenciesMeta": {
    "@molecule/app-code-editor": {
      "optional": true
    },
    "@molecule/app-ide": {
      "optional": true
    },
    "@molecule/app-live-preview": {
      "optional": true
    },
    "@molecule/app-routing-vue-router": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@molecule/app-ai-chat": "1.8.1",
    "@molecule/app-ai-models": "1.4.4",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-utilities": "1.0.7",
    "@types/node": "26.6.5",
    "@vue/test-utils": "2.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "vue": "3.5.44"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/frameworks/vue"
  },
  "homepage": "https://www.molecule.dev/packages/app-vue",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  },
  "molecule": {
    "vitestSetupFiles": [
      "@molecule/app-vue/testing/setup"
    ]
  }
}
