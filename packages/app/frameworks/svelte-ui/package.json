{
  "name": "@molecule/app-ui-svelte",
  "version": "1.1.0",
  "description": "Svelte UI components for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "svelte": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && svelte-package --input src --output dist --tsconfig ./tsconfig.json",
    "dev": "svelte-package --input src --output dist --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/frameworks/svelte-ui"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@molecule/app-auth": "^3.0.0",
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-icons": "^1.0.1",
    "@molecule/app-routing": "^1.0.1",
    "@molecule/app-svelte": "^3.4.0",
    "@molecule/app-ui": "^1.0.1",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@molecule/app-auth": "3.4.2",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-i18n": "1.2.0",
    "@molecule/app-icons": "1.0.4",
    "@molecule/app-routing": "1.1.0",
    "@molecule/app-svelte": "3.4.0",
    "@sveltejs/package": "3.0.2",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "homepage": "https://www.molecule.dev/packages/app-ui-svelte",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
