{
  "name": "@molecule/app-settings-panel-angular",
  "version": "1.0.0",
  "description": "Composable settings panel — a SettingsContainer + family of section sub-components (Account, Auth, Notifications, Billing, Devices, ThisDevice, LogOutDelete). Apps compose via content projection, picking which sections to include and what order.",
  "homepage": "https://www.molecule.dev/packages/app-settings-panel-angular",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "ngc",
    "dev": "ngc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "molecule",
    "settings",
    "panel",
    "angular"
  ],
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/features/settings-panel-angular"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@molecule/app-angular": "^3.5.0",
    "@molecule/app-auth": "^3.0.0",
    "@molecule/app-http": "^1.8.0",
    "@molecule/app-push": "^1.1.0",
    "@molecule/app-ui": "^1.0.1",
    "@molecule/app-ui-angular": "^1.1.0",
    "@molecule/app-utilities": "^1.0.6"
  },
  "devDependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@molecule/app-angular": "3.5.0",
    "@molecule/app-auth": "3.4.2",
