    "node": ">=20"
  },
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@molecule/app-auth": "^3.0.0",
    "@molecule/app-http": "^1.8.0",
    "@molecule/app-push": "^1.1.0",
    "@molecule/app-solid": "^3.11.0",
    "@molecule/app-ui": "^1.3.11",
    "@molecule/app-ui-solid": "^1.1.0",
    "@molecule/app-utilities": "^1.0.6",
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@molecule/app-auth": "3.6.0",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-http": "1.10.0",
