{
  "name": "@molecule/app-ide-panel-logic",
  "version": "1.1.0",
  "description": "Framework-neutral logic of the molecule.dev IDE panels (chat, preview, file explorer, tests), shared by every framework's IDE package",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./panels": {
      "types": "./dist/panels.d.ts",
      "import": "./dist/panels.js"
    },
    "./command-metadata": {
      "types": "./dist/command-metadata.d.ts",
      "import": "./dist/command-metadata.js"
    },
    "./settings-metadata": {
      "types": "./dist/settings-metadata.d.ts",
      "import": "./dist/settings-metadata.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@molecule/app-ai-chat": "^1.8.0",
    "@molecule/app-ai-models": "^1.0.1",
    "@molecule/app-code-editor": "^1.0.1",
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-icons": "^1.0.1",
    "@molecule/app-ide": "^1.0.1",
    "@molecule/app-live-preview": "^1.0.1",
    "@molecule/app-storage": "^1.1.1"
  },
  "devDependencies": {
    "@molecule/app-ai-chat": "1.8.0",
    "@molecule/app-ai-models": "1.4.4",
    "@molecule/app-code-editor": "1.0.3",
    "@molecule/app-i18n": "1.2.2",
    "@molecule/app-icons": "1.0.4",
    "@molecule/app-ide": "1.1.0",
    "@molecule/app-live-preview": "1.0.3",
    "@molecule/app-locales-ide": "1.11.3",
    "@molecule/app-storage": "1.1.1",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/features/ide-panel-logic"
  },
  "homepage": "https://www.molecule.dev/packages/app-ide-panel-logic",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
