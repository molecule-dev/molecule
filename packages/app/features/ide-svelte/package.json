{
  "name": "@molecule/app-ide-svelte",
  "version": "1.1.0",
  "description": "Svelte IDE components for molecule.dev workspace",
  "homepage": "https://www.molecule.dev/packages/app-ide-svelte",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./command-metadata": {
      "types": "./dist/command-metadata.d.ts",
      "default": "./dist/command-metadata.js"
    },
    "./settings-metadata": {
      "types": "./dist/settings-metadata.d.ts",
      "default": "./dist/settings-metadata.js"
    },
    "./package.json": "./package.json"
  },
  "svelte": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && svelte-package --input src --output dist --tsconfig ./tsconfig.json",
    "dev": "svelte-package --input src --output dist --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "molecule",
    "ide",
    "svelte"
  ],
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/features/ide-svelte"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@molecule/app-ide-panel-logic": "1.4.0",
    "material-file-icons": "2.4.0"
  },
  "peerDependencies": {
    "@molecule/app-ai-chat": "^1.8.0",
    "@molecule/app-ai-models": "^1.0.1",
    "@molecule/app-ai-voice": "^1.0.1",
    "@molecule/app-clipboard": "^1.0.1",
    "@molecule/app-code-editor": "^1.0.1",
    "@molecule/app-country-flags": "^1.0.1",
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-icons": "^1.0.1",
    "@molecule/app-ide": "^1.0.1",
    "@molecule/app-live-preview": "^1.0.1",
    "@molecule/app-logger": "^1.0.1",
    "@molecule/app-storage": "^1.1.1",
    "@molecule/app-theme": "1.0.4",
    "@molecule/app-svelte": "^3.5.0",
    "@molecule/app-ui": "^1.3.11",
    "@molecule/app-ui-svelte": "^1.1.0",
    "svelte": "^5.40.0"
  },
  "devDependencies": {
    "@molecule/app-ai-chat": "1.8.1",
    "@molecule/app-ai-models": "1.4.4",
    "@molecule/app-ai-voice": "1.0.3",
    "@molecule/app-clipboard": "1.0.5",
    "@molecule/app-code-editor": "1.0.3",
    "@molecule/app-country-flags": "1.0.3",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-i18n": "1.2.2",
    "@molecule/app-icons": "1.0.4",
    "@molecule/app-ide": "1.1.0",
    "@molecule/app-live-preview": "1.0.3",
    "@molecule/app-locales-ide": "1.12.0",
    "@molecule/app-logger": "1.1.0",
    "@molecule/app-storage": "1.1.1",
    "@molecule/app-svelte": "3.11.0",
    "@molecule/app-ui": "1.5.0",
    "@molecule/app-ui-svelte": "1.3.0",
    "@molecule/app-ui-tailwind": "1.3.0",
    "@sveltejs/package": "3.0.2",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/dom": "10.4.2",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
