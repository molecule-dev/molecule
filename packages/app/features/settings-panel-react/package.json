    "@molecule/app-react": "4.17.0",
    "@molecule/app-ui": "1.14.0",
    "@molecule/app-ui-react": "4.12.1",
    "@molecule/app-utilities": "1.0.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
