  "peerDependencies": {
    "@molecule/app-react": "^1.0.1",
    "@molecule/app-ui": "^1.0.1",
    "@molecule/app-ui-react": "^1.0.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@molecule/app-react": "1.0.1",
    "@molecule/app-ui": "1.0.1",
    "@molecule/app-ui-react": "1.0.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "react": "19.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
