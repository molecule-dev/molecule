{
  "name": "@molecule/app-activity-timeline-react",
  "version": "1.0.1",
  "description": "Vertical activity timeline with connector line, dot markers, and per-event icons. Sister to @molecule/app-activity-feed-react for date-grouped chronological views.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
