{
  "name": "@molecule/app-safe-link-react",
  "version": "1.0.1",
  "description": "SafeLink React Router wrapper that appends a #top fragment when target matches current path. Avoids dead-link probes that return no URL/DOM mutation on same-path clicks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "safe",
    "link",
    "react"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-router": "^7.0.0 || ^8.0.0"
  }
}
