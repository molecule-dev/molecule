{
  "name": "@molecule/app-margin-notes-html",
  "version": "1.0.2",
  "description": "Framework-free long-form reading layout with notes beside each paragraph: renders to an HTML string (build time or server), plus a small browser script for the switches, two-way hover and a phone panel that follows the reader",
  "homepage": "https://www.molecule.dev/packages/app-margin-notes-html",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "margin notes",
    "sidenotes",
    "annotations",
    "reading layout",
    "static site",
    "html"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/features/margin-notes-html"
  },
  "peerDependencies": {
    "@molecule/app-i18n": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/app-i18n": "1.0.2",
    "@types/node": "26.1.2",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
