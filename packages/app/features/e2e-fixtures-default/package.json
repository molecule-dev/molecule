{
  "name": "@molecule/app-e2e-fixtures-default",
  "version": "1.2.6",
  "description": "The @playwright/test drop-in for molecule apps: Playwright's test, expect and page with the browser supplied by the bonded e2e provider (live preview or real browsers), a console-error guard on the page fixture, and the Playwright-shaped page adapter for evaluate-only bonds.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "playwright",
    "e2e",
    "fixtures",
    "console-errors"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@molecule/app-e2e-playwright": "1.0.4"
  },
  "devDependencies": {
    "@molecule/app-bond": "1.0.5",
    "@molecule/app-e2e": "1.3.0",
    "@playwright/test": "1.64.1",
    "jsdom": "31.0.1",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@molecule/app-bond": "^1.0.1",
    "@molecule/app-e2e": "^1.0.0",
    "@playwright/test": "^1.50.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/features/e2e-fixtures-default"
  },
  "homepage": "https://www.molecule.dev/packages/app-e2e-fixtures-default",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
