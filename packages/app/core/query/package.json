{
  "name": "@molecule/app-query",
  "version": "1.0.0",
  "description": "Client-side data cache and prefetch core interface for molecule.dev — fetch once, read synchronously, warm ahead of navigation; the cache engine is a bond",
  "homepage": "https://www.molecule.dev/packages/app-query",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "query",
    "cache",
    "prefetch",
    "data-fetching"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/core/query"
  },
  "peerDependencies": {
    "@molecule/app-bond": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/app-bond": "1.0.2",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
