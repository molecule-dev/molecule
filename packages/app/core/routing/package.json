{
  "name": "@molecule/app-routing",
  "version": "1.5.2",
  "description": "Client-side routing with guards and navigation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bond-utilities": {
      "types": "./dist/bond-utilities.d.ts",
      "import": "./dist/bond-utilities.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "routing",
    "router",
    "navigation"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/app-bond": "^1.0.1",
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-logger": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/app-bond": "1.0.5",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-logger": "1.1.0",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/core/routing"
  },
  "homepage": "https://www.molecule.dev/packages/app-routing",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
