{
  "name": "@molecule/app-markdown-react-markdown",
  "version": "1.0.2",
  "description": "react-markdown provider for @molecule/app-markdown",
  "homepage": "https://www.molecule.dev/packages/app-markdown-react-markdown",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "markdown",
    "react"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/bonds/markdown/react-markdown"
  },
  "peerDependencies": {
    "@molecule/app-markdown": "^1.0.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@molecule/app-markdown": "1.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "molecule": {
    "viteOptimizeInclude": [
      "debug",
      "extend",
      "ms",
      "react-dom/server",
      "style-to-js"
    ]
  }
}
