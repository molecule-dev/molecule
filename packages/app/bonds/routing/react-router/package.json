{
  "name": "@molecule/app-routing-react-router",
  "version": "1.1.3",
  "description": "React Router v7 provider for @molecule/app-routing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "default": "./dist/dom.js"
    },
    "./dist": "./dist/index.js",
    "./dist/*": "./dist/*.js",
    "./dist/*.js": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-routing": "^1.0.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@molecule/app-i18n": "1.1.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/bonds/routing/react-router"
  },
  "homepage": "https://www.molecule.dev/packages/app-routing-react-router",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
