{
  "name": "@molecule/app-routing-react-router",
  "version": "1.10.0",
  "description": "React Router provider with URL-backed list pagination, filters, path/query selections and auth readiness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "default": "./dist/dom.js"
    },
    "./dist": "./dist/index.js",
    "./dist/*.d.ts.map": "./dist/*.d.ts.map",
    "./dist/*.d.ts": "./dist/*.d.ts",
    "./dist/*.js": "./dist/*.js",
    "./dist/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@molecule/app-auth": "^1.4.0 || ^2.0.0 || ^3.0.0",
    "@molecule/app-bond": "^1.0.1",
    "@molecule/app-http": "^1.0.0",
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-react": "^4.11.0",
    "@molecule/app-routing": "^1.5.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@molecule/app-auth": {
      "optional": true
    },
    "@molecule/app-http": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@molecule/app-auth": "3.6.0",
    "@molecule/app-bond": "1.0.5",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-http": "1.10.0",
    "@molecule/app-i18n": "1.2.2",
    "@molecule/app-query": "1.3.4",
    "@molecule/app-query-memory": "1.1.0",
    "@molecule/app-query-react": "1.8.1",
    "@molecule/app-react": "4.13.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "expect-type": "1.4.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/bonds/routing/react-router"
  },
  "homepage": "https://www.molecule.dev/packages/app-routing-react-router",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
