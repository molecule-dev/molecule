{
  "name": "@molecule/app-routing-sveltekit",
  "version": "3.0.0",
  "description": "SvelteKit client router provider for @molecule/app-routing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist": "./dist/index.js",
    "./dist/*.d.ts.map": "./dist/*.d.ts.map",
    "./dist/*.d.ts": "./dist/*.d.ts",
    "./dist/*.js": "./dist/*.js",
    "./dist/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && svelte-package --input src --output dist --tsconfig ./tsconfig.json",
    "dev": "svelte-package --input src --output dist --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "svelte-kit sync --config src/__tests__/kit-app/vite.config.ts && svelte-check --workspace src/__tests__/kit-app --fail-on-warnings && tsc -p tsconfig.tests.json"
  },
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@molecule/app-bond": "^1.0.1",
    "@molecule/app-i18n": "^1.0.1",
    "@molecule/app-routing": "^1.5.0",
    "@molecule/app-svelte": "^3.10.0",
    "@sveltejs/kit": "^3.0.0",
    "svelte": "^5.7.0"
  },
  "devDependencies": {
    "@molecule/app-bond": "1.0.5",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-i18n": "1.2.2",
    "@molecule/app-svelte": "3.10.0",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/package": "3.0.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/bonds/routing/sveltekit"
  },
  "homepage": "https://www.molecule.dev/packages/app-routing-sveltekit",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
