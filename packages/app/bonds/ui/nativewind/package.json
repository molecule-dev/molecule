      "react-native": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": "./dist/preset.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "nativewind",
    "tailwind",
    "react-native",
    "classmap"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/bonds/ui/nativewind"
  },
  "devDependencies": {
    "@molecule/app-styling": "1.0.7",
    "@molecule/app-ui": "1.15.0",
    "@molecule/app-ui-tailwind": "1.5.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "nativewind": "4.2.7",
    "postcss": "8.5.31",
    "react": "19.3.1",
    "react-native": "0.79.6",
    "react-native-css-interop": "0.2.7",
    "react-native-svg": "15.11.2",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@molecule/app-styling": "^1.0.1",
    "@molecule/app-ui": "^1.7.0",
    "@molecule/app-ui-tailwind": "^1.0.1",
    "nativewind": "^4.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native-svg": "^15.11.2",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@molecule/app-styling": {
