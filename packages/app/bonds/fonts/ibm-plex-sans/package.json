{
  "name": "@molecule/app-fonts-ibm-plex-sans",
  "version": "1.0.5",
  "description": "IBM Plex Sans font provider for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "fonts",
    "ibm-plex-sans",
    "local-fonts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/app-fonts": "^1.2.0"
  },
  "devDependencies": {
    "@molecule/app-fonts": "1.2.1",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/bonds/fonts/ibm-plex-sans"
  },
  "homepage": "https://www.molecule.dev/packages/app-fonts-ibm-plex-sans",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
