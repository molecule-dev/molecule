    "README.md"
  ],
  "keywords": [
    "molecule",
    "drag",
    "drop",
    "dndkit",
    "dnd-kit"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/app/bonds/drag-drop/dndkit"
  },
  "peerDependencies": {
    "@molecule/app-drag-drop": ">=1.0.1",
    "@molecule/app-i18n": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/app-drag-drop": "1.2.1",
    "@molecule/app-framework-conformance": "0.0.0",
    "@molecule/app-i18n": "1.3.0",
    "@types/node": "26.6.5",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
