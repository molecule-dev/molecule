{
  "name": "@molecule/api-web-content",
  "version": "1.1.0",
  "description": "Web content core interface for molecule.dev — fetch a page or extract readable content from HTML",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "web-content",
    "readability",
    "reader",
    "markdown",
    "extract"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/api-bond": "^1.0.1",
    "@molecule/api-i18n": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.2",
    "@molecule/api-i18n": "1.0.3",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/core/web-content"
  },
  "homepage": "https://www.molecule.dev/packages/api-web-content",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
