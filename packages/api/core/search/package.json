{
  "name": "@molecule/api-search",
  "version": "1.0.0",
  "description": "Full-text search core interface for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
