    "@molecule/api-i18n": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.5",
    "@molecule/api-i18n": "1.0.6",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/core/video-rooms"
  },
