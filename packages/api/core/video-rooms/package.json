  "description": "Real-time video rooms core interface — room lifecycle, signed meeting tokens, and cloud recordings — with swappable provider bonds (Daily.co default; LiveKit, Twilio Video, Agora alternates). Used by virtual-classroom, telemedicine, video-conferencing, and screen-sharing apps.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "video",
    "video-rooms",
    "webrtc",
    "conferencing"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
