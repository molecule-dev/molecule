  "devDependencies": {
    "@molecule/api-bond": "1.0.1",
    "@molecule/api-i18n": "1.0.1",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/core/compliance"
  },
  "homepage": "https://github.com/molecule-dev/molecule/tree/main/packages/api/core/compliance",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
