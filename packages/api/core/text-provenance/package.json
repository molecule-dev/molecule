{
  "name": "@molecule/api-text-provenance",
  "version": "1.0.1",
  "description": "Attributes a document's paragraphs to the agent sessions that wrote them: human or AI, the prompt and model behind each, and the AI word share",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "provenance",
    "attribution",
    "ai-written",
    "transcript"
  ],
  "license": "Apache-2.0",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "peerDependencies": {
    "@molecule/api-agent-transcript": "^1.0.0",
    "@molecule/api-bond": "^1.0.1",
    "@molecule/api-i18n": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-agent-transcript": "1.0.1",
    "@molecule/api-bond": "1.0.2",
    "@molecule/api-i18n": "1.0.3",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/core/text-provenance"
  },
  "homepage": "https://www.molecule.dev/packages/api-text-provenance",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
