{
  "name": "@molecule/api-ocr",
  "version": "1.1.0",
  "description": "Abstract OCR (text extraction from images) interface — bond a vision model, Tesseract, or molecule.dev's hosted service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
