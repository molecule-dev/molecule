  "devDependencies": {
    "@molecule/api-bond": "1.0.2",
    "@molecule/api-i18n": "1.0.3",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/core/ocr"
  },
  "homepage": "https://www.molecule.dev/packages/api-ocr",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
