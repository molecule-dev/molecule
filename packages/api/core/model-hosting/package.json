{
  "name": "@molecule/api-model-hosting",
  "version": "1.0.0",
  "description": "Model hosting for molecule.dev — run a model server container on rented GPUs or CPUs (Cloud Run, Modal, RunPod, Koyeb) or your own Docker host, and get an HTTPS URL plus auth headers, behind swappable bonds",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "model-hosting",
    "gpu",
    "inference",
    "serverless",
    "scale-to-zero"
  ],
  "license": "Apache-2.0",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "peerDependencies": {
    "@molecule/api-bond": "^1.0.1",
    "@molecule/api-i18n": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.2",
    "@molecule/api-i18n": "1.0.3",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/core/model-hosting"
  },
  "homepage": "https://www.molecule.dev/packages/api-model-hosting",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
