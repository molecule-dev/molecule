{
  "name": "@molecule/api-database",
  "version": "1.2.1",
  "description": "Database core interface for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./query-guards.js": {
      "types": "./dist/query-guards.d.ts",
      "import": "./dist/query-guards.js"
    },
    "./sql-compatibility.js": {
      "types": "./dist/sql-compatibility.d.ts",
      "import": "./dist/sql-compatibility.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "database",
    "sql",
    "postgresql",
    "mysql"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/api-bond": "^1.0.1",
    "@molecule/api-i18n": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.4",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/core/database"
  },
  "homepage": "https://www.molecule.dev/packages/api-database",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
