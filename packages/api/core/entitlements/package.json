{
  "name": "@molecule/api-entitlements",
  "version": "1.0.1",
  "description": "Tier-based entitlements core interface for molecule.dev: typed quantitative limits per subscription plan, plan-key cache, and tier-aware middleware factories",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "entitlements",
    "tier",
    "subscription",
    "limits",
    "billing"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/api-bond": "^1.0.1",
    "@molecule/api-database": "^1.0.1",
    "@molecule/api-i18n": "^1.0.1",
    "@molecule/api-rate-limit": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.1",
    "@molecule/api-database": "1.0.1",
    "@molecule/api-i18n": "1.0.1",
    "@molecule/api-payments": "1.2.0",
    "@molecule/api-payments-stripe": "1.2.1",
    "@molecule/api-rate-limit": "1.0.1",
    "@molecule/api-resource": "1.0.1",
    "@types/node": "26.1.2",
    "stripe": "22.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/core/entitlements"
  },
  "homepage": "https://github.com/molecule-dev/molecule/tree/main/packages/api/core/entitlements",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
