{
  "name": "@molecule/api-email-templates",
  "version": "1.0.3",
  "description": "Transactional email templates for molecule.dev: i18n-driven subject/text/html templates with variable interpolation, sent via the bonded email transport",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "email",
    "templates",
    "transactional",
    "i18n"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/api-emails": "^1.0.1",
    "@molecule/api-i18n": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-emails": "1.0.3",
    "@molecule/api-i18n": "1.0.5",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/core/email-templates"
  },
  "homepage": "https://www.molecule.dev/packages/api-email-templates",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
