{
  "name": "@molecule/api-process-lifecycle",
  "version": "1.2.0",
  "description": "Process lifecycle core interface for molecule.dev: named readiness and liveness checks with timeouts and criticality, a drain state, in-flight request tracking, and ordered shutdown hooks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "molecule",
    "lifecycle",
    "readiness",
    "liveness",
    "graceful shutdown",
    "drain"
  ],
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@molecule/api-bond": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.2",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/core/process-lifecycle"
  },
  "homepage": "https://www.molecule.dev/packages/api-process-lifecycle",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
