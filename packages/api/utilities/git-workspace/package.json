{
  "name": "@molecule/api-git-workspace",
  "version": "1.0.4",
  "description": "Multi-repo git workspace utilities — discover every repository in a polyrepo workspace (including nested, gitignored and bare ones), checkpoint uncommitted work, bundle each repo to a single file, and verify an archive reconstructs the workspace before anything is released.",
  "homepage": "https://www.molecule.dev/packages/api-git-workspace",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "git",
    "workspace",
    "polyrepo",
    "bundle",
    "archive"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/utilities/git-workspace"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
