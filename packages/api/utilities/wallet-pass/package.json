{
  "name": "@molecule/api-wallet-pass",
  "version": "1.0.1",
  "description": "Apple Wallet (.pkpass) + Google Wallet pass-object generation — signed manifests, JWT-signed pass classes, and HTTP handlers for ticket delivery.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "wallet-pass",
    "apple-wallet",
    "pkpass",
    "google-wallet",
    "ticket"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/utilities/wallet-pass"
  },
  "dependencies": {
    "node-forge": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/node-forge": "1.3.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
