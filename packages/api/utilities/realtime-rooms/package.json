{
  "name": "@molecule/api-realtime-rooms",
  "version": "1.0.1",
  "description": "Realtime rooms abstraction: named pub/sub rooms with membership, capacity, join codes, role-based auth, built atop @molecule/api-realtime.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "realtime",
    "rooms",
    "pubsub",
    "presence"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@molecule/api-database": "^1.0.1",
    "@molecule/api-realtime": "^1.0.1"
  },
  "peerDependenciesMeta": {
    "@molecule/api-database": {
      "optional": true
    },
    "@molecule/api-realtime": {
      "optional": true
    }
  }
}
