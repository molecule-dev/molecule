  },
  "devDependencies": {
    "@molecule/api-project-archive": "1.0.1",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@molecule/api-project-archive": "^1.0.1"
  }
}
