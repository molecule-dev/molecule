{
  "name": "@molecule/api-project-archive-external-state-postgresql",
  "version": "1.0.4",
  "description": "Back up and restore a project's PostgreSQL database as part of a project archive — captures it with pg_dump --format=custom into an archive part and puts it back with pg_restore, proving the dump decodes in full before the caller is allowed to destroy the original.",
  "homepage": "https://www.molecule.dev/packages/api-project-archive-external-state-postgresql",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "project",
    "archive",
    "postgresql",
    "backup"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/project-archive-external-state/postgresql"
  },
  "peerDependencies": {
    "@molecule/api-project-archive": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-project-archive": "1.0.3",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
