{
  "name": "@molecule/api-agent-transcript-autodetect",
  "version": "1.1.2",
  "description": "Picks the reader that recognizes a transcript and delegates to it; bundles readers for Claude Code, Codex CLI, the Molecule IDE, Gemini CLI, Cline / Roo Code, OpenCode, GitHub Copilot Chat, Cursor and Aider, plus a generic Markdown chat reader",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "agent",
    "transcript",
    "detect",
    "claude-code",
    "codex",
    "gemini-cli",
    "aider",
    "cursor",
    "cline",
    "opencode",
    "copilot"
  ],
  "license": "Apache-2.0",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "dependencies": {
    "@molecule/api-agent-transcript-aider": "1.0.1",
    "@molecule/api-agent-transcript-claude-code": "1.0.0",
    "@molecule/api-agent-transcript-cline": "1.0.1",
    "@molecule/api-agent-transcript-codex": "1.0.0",
    "@molecule/api-agent-transcript-copilot-chat": "1.0.1",
    "@molecule/api-agent-transcript-cursor": "1.0.1",
    "@molecule/api-agent-transcript-gemini-cli": "1.0.1",
    "@molecule/api-agent-transcript-markdown-chat": "1.0.1",
    "@molecule/api-agent-transcript-molecule-ide": "1.0.0",
    "@molecule/api-agent-transcript-opencode": "1.0.1"
  },
  "peerDependencies": {
    "@molecule/api-agent-transcript": "^1.0.0"
  },
  "devDependencies": {
    "@molecule/api-agent-transcript": "1.0.1",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/agent-transcript/autodetect"
  },
  "homepage": "https://www.molecule.dev/packages/api-agent-transcript-autodetect",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
