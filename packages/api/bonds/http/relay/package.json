{
  "name": "@molecule/api-http-relay",
  "version": "1.0.0",
  "description": "Egress relay HTTP client for molecule.dev — outbound HTTP through the platform relay for runtimes that cannot dial out",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "http",
    "fetch",
    "relay",
    "egress",
    "browser"
  ],
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/api-http": "^1.0.1",
    "@molecule/api-secrets": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-http": "1.0.2",
    "@molecule/api-secrets": "1.0.2",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/http/relay"
  },
  "homepage": "https://www.molecule.dev/packages/api-http-relay",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
