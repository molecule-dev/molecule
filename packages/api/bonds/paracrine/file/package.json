{
  "name": "@molecule/api-paracrine-file",
  "version": "1.1.0",
  "description": "Zero-config file-backed paracrine store — messages between the AI agents on one machine, with a paracrine CLI any harness can use.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "paracrine": "dist/cli-main.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "paracrine",
    "agent",
    "agent-to-agent",
    "messaging",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "devDependencies": {
    "@molecule/api-paracrine": "1.1.0",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@molecule/api-paracrine": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/paracrine/file"
  },
  "homepage": "https://www.molecule.dev/packages/api-paracrine-file",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
