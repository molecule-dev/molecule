  },
  "peerDependencies": {
    "@molecule/api-ai-translation": ">=1.1.0"
  },
  "devDependencies": {
    "@molecule/api-ai-translation": "1.1.0",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
