{
  "name": "@molecule/api-uploads-encrypted",
  "version": "1.1.1",
  "description": "Encrypting upload provider for molecule.dev — encrypts every file before another upload provider stores it, decrypts on read.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "molecule",
    "uploads",
    "encryption",
    "aes-256-gcm",
    "encryption-at-rest",
    "files"
  ],
  "license": "Apache-2.0",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "dependencies": {
    "@molecule/api-analytics": "1.1.0"
  },
  "devDependencies": {
    "@molecule/api-encryption": "1.1.0",
    "@molecule/api-encryption-aes": "1.1.1",
    "@molecule/api-uploads": "1.0.2",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@molecule/api-encryption": "^1.1.0",
    "@molecule/api-uploads": "^1.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/uploads/encrypted"
  },
  "homepage": "https://www.molecule.dev/packages/api-uploads-encrypted",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
