{
  "name": "@molecule/api-password-bcrypt",
  "version": "1.1.0",
  "description": "Password hashing provider using native bcrypt, falling back to bcryptjs, for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "password",
    "bcrypt",
    "bcryptjs",
    "native",
    "provider"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "bcrypt": "6.0.0",
    "bcryptjs": "3.0.3"
  },
  "peerDependencies": {
    "@molecule/api-password": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-password": "1.0.3",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/password/bcrypt"
  },
  "homepage": "https://www.molecule.dev/packages/api-password-bcrypt",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
