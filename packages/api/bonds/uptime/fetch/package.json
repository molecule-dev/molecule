      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "uptime",
    "monitoring",
    "health",
    "probe",
    "availability"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/api-uptime": ">=1.0.0"
  },
  "devDependencies": {
    "@molecule/api-uptime": "1.0.0",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/uptime/fetch"
  },
  "homepage": "https://www.molecule.dev/packages/api-uptime-fetch",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
