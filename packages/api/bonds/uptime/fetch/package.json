{
  "name": "@molecule/api-uptime-fetch",
  "version": "1.0.0",
  "description": "In-process uptime provider for molecule.dev — probe an http(s) URL with verified public dialing, status assertions and TLS inspection",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
