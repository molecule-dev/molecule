{
  "name": "@molecule/api-screenshots-molecule",
  "version": "1.1.1",
  "description": "molecule.dev hosted screenshot capture — URL or HTML to image, billed to your molecule project, no vendor account",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "screenshots",
    "capture",
    "og-image",
    "hosted"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/api-secrets": "^1.0.1",
    "@molecule/api-screenshots": ">=1.0.0"
  },
  "devDependencies": {
    "@molecule/api-screenshots": "1.1.1",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/screenshots/molecule"
  },
  "homepage": "https://www.molecule.dev/packages/api-screenshots-molecule",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
