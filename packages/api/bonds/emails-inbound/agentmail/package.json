{
  "name": "@molecule/api-emails-inbound-agentmail",
  "version": "1.0.0",
  "description": "AgentMail inbound email provider — verifies Svix-signed AgentMail webhooks and parses message.received payloads into normalized InboundEmail, replying through the AgentMail API.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "emails",
    "inbound",
    "agentmail",
    "svix",
    "webhook"
  ],
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "devDependencies": {
    "@molecule/api-emails-inbound": "1.0.1",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@molecule/api-emails-inbound": "^1.0.1",
    "@molecule/api-secrets": "^1.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/emails-inbound/agentmail"
  },
  "homepage": "https://github.com/molecule-dev/molecule/tree/main/packages/api/bonds/emails-inbound/agentmail",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
