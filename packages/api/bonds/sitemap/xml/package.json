{
  "name": "@molecule/api-sitemap-xml",
  "version": "1.0.1",
  "description": "XML sitemap, RSS, and Atom feed provider for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "sitemap",
    "xml",
    "rss",
    "atom",
    "feed"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/api-sitemap": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-sitemap": "1.0.1",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/sitemap/xml"
  },
  "homepage": "https://github.com/molecule-dev/molecule/tree/main/packages/api/bonds/sitemap/xml",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
