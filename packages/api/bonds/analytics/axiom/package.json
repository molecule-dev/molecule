{
  "name": "@molecule/api-analytics-axiom",
  "version": "1.0.1",
  "description": "Axiom analytics provider for molecule.dev — batches tracked events into an Axiom dataset over the ingest API, never blocking the caller.",
  "homepage": "https://www.molecule.dev/packages/api-analytics-axiom",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "analytics",
    "axiom",
    "observability",
    "telemetry"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/analytics/axiom"
  },
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@molecule/api-analytics": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-analytics": "1.1.0",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
