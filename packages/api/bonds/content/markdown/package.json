{
  "name": "@molecule/api-content-markdown",
  "version": "1.0.1",
  "description": "Content provider for front-matter markdown files: YAML front matter between --- fences plus a markdown body, read from a directory, with loud validation of malformed files",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "content",
    "markdown",
    "front-matter",
    "yaml",
    "static-site"
  ],
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "dependencies": {
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@molecule/api-content": "^1.0.0"
  },
  "devDependencies": {
    "@molecule/api-content": "1.0.1",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/content/markdown"
  },
  "homepage": "https://github.com/molecule-dev/molecule/tree/main/packages/api/bonds/content/markdown",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
