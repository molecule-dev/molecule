  },
  "peerDependencies": {
    "@molecule/api-ocr": ">=1.0.0"
  },
  "devDependencies": {
    "@molecule/api-ocr": "1.0.0",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/ocr/tesseract"
