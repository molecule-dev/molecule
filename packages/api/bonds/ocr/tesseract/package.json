      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "ocr",
    "tesseract",
    "self-hosted",
    "text-recognition"
  ],
  "license": "Apache-2.0",
