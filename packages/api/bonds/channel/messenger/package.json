{
  "name": "@molecule/api-channel-messenger",
  "version": "1.0.1",
  "description": "Facebook Messenger channel bond — implements @molecule/api-channel for sendMessage via the Send API, X-Hub-Signature-256 webhook verification, and inbound entry/messaging parsing.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "channel",
    "messenger"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@molecule/api-channel": "1.0.1",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@molecule/api-channel": "^1.0.1",
    "@molecule/api-secrets": "^1.0.1"
  },
  "peerDependenciesMeta": {
    "@molecule/api-channel": {
      "optional": true
    }
  }
}
