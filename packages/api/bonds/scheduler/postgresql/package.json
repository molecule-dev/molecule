{
  "name": "@molecule/api-scheduler-postgresql",
  "version": "1.1.1",
  "description": "PostgreSQL-coordinated scheduler provider for @molecule/api-scheduler: in-process timers that take a per-task advisory lock so a scheduled task runs ONCE across every API instance.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "molecule",
    "scheduler",
    "cron",
    "postgresql",
    "advisory lock",
    "multi-instance"
  ],
  "license": "Apache-2.0",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "peerDependencies": {
    "@molecule/api-bond": "^1.0.1",
    "@molecule/api-scheduler": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.3",
    "@molecule/api-i18n": "1.0.4",
    "@molecule/api-scheduler": "1.1.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/scheduler/postgresql"
  },
  "homepage": "https://www.molecule.dev/packages/api-scheduler-postgresql",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
