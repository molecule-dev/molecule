  },
  "devDependencies": {
    "@molecule/api-payments": "1.2.1",
    "@types/node": "26.1.2",
    "stripe": "22.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/payments/capture"
  },
  "homepage": "https://www.molecule.dev/packages/api-payments-capture",
