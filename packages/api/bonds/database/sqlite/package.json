{
  "name": "@molecule/api-database-sqlite",
  "version": "1.0.1",
  "description": "SQLite database provider for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store.js": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./utilities.js": {
      "types": "./dist/utilities.d.ts",
      "import": "./dist/utilities.js"
    }
  },
  "keywords": [
    "molecule",
    "database",
    "sqlite"
  ],
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "13.0.2"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.1",
    "@molecule/api-database": "1.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@molecule/api-bond": "^1.0.1",
    "@molecule/api-database": "^1.0.1",
    "@molecule/api-secrets": "^1.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/database/sqlite"
  },
  "homepage": "https://github.com/molecule-dev/molecule/tree/main/packages/api/bonds/database/sqlite",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
