{
  "name": "@molecule/api-database-duckdb",
  "version": "1.1.1",
  "description": "DuckDB database provider for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lifecycle.js": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js"
    },
    "./migrator.js": {
      "types": "./dist/migrator.d.ts",
      "import": "./dist/migrator.js"
    },
    "./pool.js": {
      "types": "./dist/pool.d.ts",
      "import": "./dist/pool.js"
    },
    "./queue.js": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js"
    },
    "./store.js": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./utilities.js": {
      "types": "./dist/utilities.d.ts",
      "import": "./dist/utilities.js"
    },
    "./capabilities.js": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    }
  },
  "keywords": [
    "molecule",
    "database",
    "duckdb"
  ],
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.3",
    "@molecule/api-database": "1.2.0",
    "@molecule/api-process-lifecycle": "1.2.1",
    "@molecule/api-process-lifecycle-express": "1.3.1",
    "@molecule/api-secrets": "1.0.2",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@molecule/api-bond": "^1.0.1",
    "@molecule/api-database": "^1.2.0",
    "@molecule/api-secrets": "^1.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/database/duckdb"
  },
  "homepage": "https://www.molecule.dev/packages/api-database-duckdb",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
