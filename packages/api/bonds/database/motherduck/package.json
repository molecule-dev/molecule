{
  "name": "@molecule/api-database-motherduck",
  "version": "1.1.1",
  "description": "MotherDuck hosted DuckDB database provider for molecule.dev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store.js": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./capabilities.js": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    }
  },
  "keywords": [
    "molecule",
    "database",
    "motherduck",
    "duckdb"
  ],
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@molecule/api-database-duckdb": "1.1.1"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.3",
    "@molecule/api-database": "1.2.0",
    "@molecule/api-database-duckdb": "1.1.1",
    "@molecule/api-secrets": "1.0.2",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@molecule/api-bond": "^1.0.1",
    "@molecule/api-database": "^1.2.0",
    "@molecule/api-database-duckdb": "^1.0.0",
    "@molecule/api-secrets": "^1.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/database/motherduck"
  },
  "homepage": "https://www.molecule.dev/packages/api-database-motherduck",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
