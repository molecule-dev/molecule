{
  "name": "@molecule/api-video-meetings-zoom",
  "version": "1.0.3",
  "description": "Zoom video meetings provider for molecule.dev. Implements @molecule/api-video-meetings via the Zoom REST v2 API with Server-to-Server OAuth (account-level token caching) and per-request user-OAuth token support.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "video",
    "video-meetings",
    "zoom",
    "scheduled-meetings",
    "conferencing"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@molecule/api-secrets": "^1.0.1",
    "@molecule/api-video-meetings": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-video-meetings": "1.0.4",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/video-meetings/zoom"
  },
  "homepage": "https://www.molecule.dev/packages/api-video-meetings-zoom",
  "bugs": "https://github.com/molecule-dev/molecule/issues",
  "publishConfig": {
    "access": "public"
  }
}
