{
  "name": "@molecule/api-project-archive-object-storage",
  "version": "1.0.3",
  "description": "Object-storage project archive provider — gzipped POSIX tar artifact persisted through the bonded uploads provider (S3, R2, B2, MinIO, filesystem), with a post-upload read-back verification gate. Zero external dependencies.",
  "homepage": "https://www.molecule.dev/packages/api-project-archive-object-storage",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "project",
    "archive",
    "object-storage",
    "tar",
    "backup",
    "restore",
    "verification",
    "parts"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/project-archive/object-storage"
  },
  "peerDependencies": {
    "@molecule/api-logger": ">=1.0.1",
    "@molecule/api-project-archive": ">=1.0.1",
    "@molecule/api-uploads": ">=1.0.1"
  },
  "devDependencies": {
    "@molecule/api-logger": "1.0.3",
    "@molecule/api-project-archive": "1.0.3",
    "@molecule/api-uploads": "1.1.1",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
