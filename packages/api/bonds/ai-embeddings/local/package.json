{
  "name": "@molecule/api-ai-embeddings-local",
  "version": "1.0.1",
  "description": "Local (offline) ai-embeddings provider for molecule.dev — runs a small sentence-embedding model in-process via Transformers.js (onnxruntime); no API key and no network at query time",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "ai",
    "embeddings",
    "local",
    "offline",
    "transformers",
    "onnx"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/molecule-dev/molecule.git",
    "directory": "packages/api/bonds/ai-embeddings/local"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "peerDependencies": {
    "@molecule/api-ai-embeddings": ">=1.0.1"
  },
  "devDependencies": {
    "@molecule/api-ai-embeddings": "1.0.1",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
