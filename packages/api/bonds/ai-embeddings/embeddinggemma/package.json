  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "peerDependencies": {
    "@molecule/api-ai-embeddings": ">=1.1.0"
  },
  "devDependencies": {
    "@molecule/api-ai-embeddings": "1.1.0",
