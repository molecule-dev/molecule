{
  "name": "@molecule/api-model-hosting-koyeb",
  "version": "1.0.0",
  "description": "Koyeb model hosting for molecule.dev — run a model server container on CPU or an RTX 4000 / L4 GPU in the EU or US, with sleep when idle",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "molecule",
    "model-hosting",
    "koyeb",
    "gpu",
    "serverless",
    "eu"
  ],
  "license": "Apache-2.0",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "peerDependencies": {
    "@molecule/api-bond": "^1.0.1",
    "@molecule/api-i18n": "^1.0.1",
    "@molecule/api-model-hosting": "^1.0.0",
    "@molecule/api-secrets": "^1.0.1"
  },
  "devDependencies": {
    "@molecule/api-bond": "1.0.2",
    "@molecule/api-i18n": "1.0.3",
    "@molecule/api-model-hosting": "1.0.0",
    "@molecule/api-secrets": "1.0.2",
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
